# Copy these into Vercel -> Project -> Settings -> Environment Variables (Production). NEVER commit real values.

# Zoho SMTP (sales@ebikesforsale.com.au)
SMTP_HOST=smtp.zoho.com          # use smtp.zoho.com.au if your Zoho account is on the .com.au data centre
SMTP_PORT=465
SMTP_USER=sales@ebikesforsale.com.au
SMTP_PASS=                       # Zoho APP PASSWORD (not your login password)
SMTP_FROM="e bikes for sale <sales@ebikesforsale.com.au>"

# Where notifications go (all optional; default to sales@ebikesforsale.com.au)
ORDER_EMAIL=sales@ebikesforsale.com.au
CONTACT_EMAIL=sales@ebikesforsale.com.au
WHOLESALE_EMAIL=sales@ebikesforsale.com.au

# Admin portal passcode for /admin
ADMIN_PASSCODE=

# Upstash Redis (added automatically by Vercel -> Storage -> Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
